      "targets": [{ "refId": "A", "expr": "broker_latency_p95" }]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "llm_cost (total)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "llm_cost_total" }]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "llm_latency (p95)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "llm_latency_p95" }]
    }
  ]
}

