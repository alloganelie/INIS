      "targets": [{ "refId": "A", "expr": "cache_hit_rate" }]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "vector_search_latency (p95)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "vector_search_latency_p95" }]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "postgres_latency (p95)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
