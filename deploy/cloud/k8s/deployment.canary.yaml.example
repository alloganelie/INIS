apiVersion: apps/v1
kind: Deployment
metadata:
  name: inis-api-canary
  namespace: inis
  labels:
    app.kubernetes.io/name: inis
    app.kubernetes.io/component: api
    track: canary
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: inis
      track: canary
  template:
    metadata:
      labels:
        app.kubernetes.io/name: inis
        track: canary
    spec:
      containers:
        - name: inis-api
          image: inis/api:2.0.0-canary
          envFrom:
            - secretRef:
                name: inis-secrets
          ports:
            - containerPort: 8000
          readinessProbe:
            httpGet:
              path: /v1/health/ready
              port: 8000
            initialDelaySeconds: 5
            periodSeconds: 10
---
apiVersion: networking.istio.io/v1alpha3
kind: VirtualService
metadata:
  name: inis-api-canary-routing
  namespace: inis
spec:
  hosts:
    - api.inis.internal
  http:
    - route:
        - destination:
            host: inis-api-stable
          weight: 95
        - destination:
            host: inis-api-canary
          weight: 5
