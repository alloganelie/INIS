apiVersion: v1
kind: Secret
metadata:
  name: inis-secrets
  namespace: inis
  labels:
    app.kubernetes.io/name: inis
    app.kubernetes.io/component: api
type: Opaque
stringData:
  # Primary LLM API Key (OpenAI, Anthropic, Gemini, etc.)
  LLM_API_KEY: "PLACEHOLDER_LLM_API_KEY"

  # Search Provider API Key
  SERPER_API_KEY: "PLACEHOLDER_SERPER_API_KEY"

  # Primary PostgreSQL connection string with pgvector
  DATABASE_URL: "postgresql://inis_user:PLACEHOLDER_DB_PASSWORD@postgres.internal:5432/inis_db"
  INIS_DATABASE_URL: "postgresql://inis_user:PLACEHOLDER_DB_PASSWORD@postgres.internal:5432/inis_db"

  # Object storage credentials (S3/GCS/Azure)
  S3_ENDPOINT: "https://s3.eu-west-3.amazonaws.com"
  S3_ACCESS_KEY: "PLACEHOLDER_S3_ACCESS_KEY"
  S3_SECRET_KEY: "PLACEHOLDER_S3_SECRET_KEY"

  # Authentication token secret (HS256)
  JWT_SECRET: "PLACEHOLDER_JWT_SECRET_HEX_64_CHARS"

  # OBLIGATORY in production. Enables the AuthMiddleware (§19).
  INIS_AUTH_ENABLED: "true"

  # OBLIGATORY in production (§19 rate limiting).
  # Defaults to "true" when INIS_AUTH_ENABLED=true, but set it explicitly so an
  # accidental auth flag flip can never silently unmeter the API.
  INIS_RATE_LIMIT_ENABLED: "true"

  # Per-actor budget, requests per minute. Token bucket, keyed on actor_id.
  RATE_LIMIT_RPM: "60"

  # Redis connection URL
  REDIS_URL: "redis://:PLACEHOLDER_REDIS_PASSWORD@redis.internal:6379/0"

  # RabbitMQ message broker URL
  RABBITMQ_URL: "amqp://inis:PLACEHOLDER_RABBIT_PASSWORD@rabbitmq.internal:5672//"
