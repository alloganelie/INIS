# INIS — variables d'environnement (§4, §19, §22).
#
#   cp .env.example .env   puis renseigner les valeurs ; `.env` est ignoré par
#   git (`.gitignore`), ne jamais committer de secret.
#
# Toutes les variables listées ici sont réellement lues par `app/` ; celles qui
# sont optionnelles activent un mode dégradé explicitement remonté par
# `GET /v1/health` (jamais un succès silencieux).

# ── Runtime ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# ── Persistance (§4.2, §16) ────────────────────────────────────────────────
# Alembic tourne sur le moteur asynchrone (migrations/env.py) : les DEUX URL
# doivent donc utiliser un driver async (asyncpg). Une URL psycopg2 ferait
# échouer `make migrate` avec "requires an async driver".
# Laisser vide démarre en mode mémoire : plus aucune donnée ne survit à l'arrêt.
INIS_DATABASE_URL=postgresql+asyncpg://inis:inis_dev_password@localhost:5432/inis_db
DATABASE_URL=postgresql+asyncpg://inis:inis_dev_password@localhost:5432/inis_db
# `INIS_NULL_POOL=1` remplace le pool par NullPool (tests multi boucles).
INIS_NULL_POOL=

# ── Cache et messagerie (§4.4, §41.5) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=inis
REDIS_TTL_SECONDS=300
AMQP_URL=amqp://inis:inis_dev_password@localhost:5672//
INIS_BROKER_URL=
# MQTT : transport optionnel, sans variable d'environnement lue aujourd'hui.

# ── Stockage objet (§4.3) ──────────────────────────────────────────────────
# Passées au client S3 par le point de composition (aucun `os.getenv` interne).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=inis_dev_access
S3_SECRET_KEY=inis_dev_secret
S3_BUCKET=inis-artifacts
S3_REGION=eu-west-3
S3_USE_SSL=false

# ── Recherche web (§9) ─────────────────────────────────────────────────────
# Sans clé : provider Wikipedia + mode dégradé déclaré (jamais de fait inventé).
SERPER_API_KEY=
SERPER_ENDPOINT=https://google.serper.dev/search

# ── LLM (§22) ──────────────────────────────────────────────────────────────
# Sans clé : ModelRouter répond un stub *déclaré* (`stub: true`), jamais une
# réponse présentée comme réelle.
# ⚠️ Les *embeddings* §16.1 n'ont pas de stub : sans LLM_API_KEY l'appel **lève**
# (un vecteur inventé serait indiscernable d'un vrai une fois stocké) et la
# mémoire §17.1 se dégrade en recherche lexicale seule, en le disant.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_DEFAULT=
LLM_PROBE_MAX_TOKENS=16
# §16.1 — modèle d'embeddings (endpoint OpenAI-compatible `/embeddings`).
# Défaut : text-embedding-3-small ; la dimension attendue est celle de la colonne
# `embeddings.vector` (1536, migration 0003) : une autre largeur est refusée.
LLM_EMBEDDING_MODEL=
# §16.1 — textes par appel d'embeddings (défaut : 32).
LLM_EMBEDDING_BATCH=
# §22.2 — chaîne de repli ordonnée, du modèle le plus intéressant au moins
# intéressant (identifiants séparés par des virgules, jamais d'espace requis).
# Chaque candidat est essayé après épuisement du budget de retry du précédent.
# Vide = aucun repli : le premier échec remonte en InfrastructureError.
# La liste change souvent côté fournisseur : la rafraîchir depuis le catalogue
# public (`GET {LLM_BASE_URL}/models`) avant de la figer en production.
# Exemple vérifié le 2026-09-28 (16 modèles `:free` au catalogue), du plus
# capable au plus sobre — remplacer le modèle principal par le second si le
# premier est saturé, et inversement :
# LLM_MODEL_FALLBACKS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,thinkingmachines/inkling:free,qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free
LLM_MODEL_FALLBACKS=
# §41.8 — tentatives totales par modèle, première comprise (défaut : 3).
LLM_RETRY_ATTEMPTS=3

# ── Sécurité (§19) ─────────────────────────────────────────────────────────
JWT_SECRET=dev_only_change_me
ACCESS_TOKEN_TTL_SECONDS=3600
INIS_AUTH_ENABLED=false
INIS_RATE_LIMIT_ENABLED=false
INIS_API_KEY=
INIS_RESUME_SECRET=dev_only_resume_secret
INIS_VAULT_KEY=
INIS_CRED_SRC_ALPHA=

# ── Observabilité et build (§20, §34) ──────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
INIS_GIT_SHA=
INIS_BUILT_AT=
GIT_COMMIT=

# ── Identifiants des conteneurs (docker compose uniquement) ────────────────
POSTGRES_USER=inis
POSTGRES_PASSWORD=inis_dev_password
POSTGRES_DB=inis_db
RABBITMQ_USER=inis
RABBITMQ_PASSWORD=inis_dev_password
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

